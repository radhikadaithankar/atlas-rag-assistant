# Placeholders only. Copy to .env for local runs. Do not commit .env.
# An empty key is unset. Whitespace in a key is invalid.
# If OPENAI_API_KEY is set, embeddings and generation use OpenAI.
# If only GEMINI_API_KEY is set, they use Gemini.
# If neither is set, the API still boots. Keyword search works.
# Vector search, hybrid search, embed, and ask return 503.

OPENAI_API_KEY=
GEMINI_API_KEY=
DATABASE_URL=postgresql://user:password@localhost:5432/atlas

# Frozen by the migrations. Another width needs a new migration.
EMBEDDING_DIMENSIONS=1536

# Optional overrides. Unset uses the provider default:
# OpenAI text-embedding-3-small and gpt-6-luna,
# Gemini gemini-embedding-001 (output dimensionality 1536) and gemini-3.5-flash-lite.
EMBEDDING_MODEL=
GENERATION_MODEL=

CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_UPLOAD_BYTES=10485760
RRF_K=60
RERANK_POOL=20

# Set to cross_encoder only when the rerank extra is installed.
# The API image does not install that extra.
RERANKER=

# Streamlit process only. The API does not read this.
ATLAS_API_URL=http://127.0.0.1:8000
